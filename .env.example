# Copy to .env and fill in values from your Supabase project (Settings → API)
PORT=3000

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key (server-side ONLY — never ship this in the iOS app)
SUPABASE_SERVICE_ROLE_KEY=

# Anon key (used to verify incoming user JWTs)
SUPABASE_ANON_KEY=

# Storage bucket for photo evidence
SUPABASE_STORAGE_BUCKET=evidence
